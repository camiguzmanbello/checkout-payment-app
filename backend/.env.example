DATABASE_URL="postgresql://user:password@localhost:5432/checkout_db?schema=public"
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Payment provider sandbox credentials — get the real values from the provider
# dashboard and put them in .env (never committed).
PAYMENT_GATEWAY_SANDBOX_URL=<provider sandbox base url, e.g. https://.../v1>
PAYMENT_GATEWAY_PUBLIC_KEY=pub_stagtest_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_GATEWAY_PRIVATE_KEY=prv_stagtest_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Integrity secret: dashboard > Developers > secrets for technical integration.
# Used to sign every transaction (SHA256 of reference + amount + currency + secret).
PAYMENT_GATEWAY_INTEGRITY_SECRET=stagtest_integrity_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Card charges start as PENDING; these control how long the backend
# waits for the provider to finalize them before giving up.
PAYMENT_GATEWAY_POLL_INTERVAL_MS=1500
PAYMENT_GATEWAY_POLL_TIMEOUT_MS=25000
